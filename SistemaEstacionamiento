package sistemaestacionamiento;

import java.util.Scanner;

public class SistemaEstacionamiento {

    // Constantes
    static final int FILAS = 8;
    static final int COLUMNAS = 8;
    static final double TARIFA = 10.00;

    // Variables globales
    static Scanner entrada = new Scanner(System.in);

    static String[][] placas = new String[FILAS][COLUMNAS];

    static int vehiculosCobrados = 0;
    static double totalIngresos = 0.0;

    // Posición de entrada y salida
    static int filaEntrada;
    static int columnaEntrada;
    static int filaSalida;
    static int columnaSalida;

    // =========================
    // MÉTODO MAIN
    // =========================
    public static void main(String[] args) {

        inicializarEstacionamiento();

        generarEntradaSalida();

        menuPrincipal();

        entrada.close();
    }

    // =========================
    // INICIALIZAR ESTACIONAMIENTO
    // =========================
    public static void inicializarEstacionamiento() {

        for (int i = 0; i < FILAS; i++) {

            for (int j = 0; j < COLUMNAS; j++) {

                placas[i][j] = null;
            }
        }
    }

    // =========================
    // GENERAR ENTRADA Y SALIDA
    // =========================
    public static void generarEntradaSalida() {

        // Para este ejemplo se colocan posiciones fijas
        filaEntrada = 0;
        columnaEntrada = 1;

        filaSalida = 0;
        columnaSalida = 6;
    }

    // =========================
    // MENÚ PRINCIPAL
    // =========================
    public static void menuPrincipal() {

        int opcion;

        do {

            System.out.println();
            System.out.println("==========================================");
            System.out.println("     SISTEMA DE ESTACIONAMIENTO");
            System.out.println("==========================================");
            System.out.println("1. Ingresar vehiculo");
            System.out.println("2. Retirar vehiculo");
            System.out.println("3. Mostrar estacionamiento");
            System.out.println("4. Buscar vehiculo por placa");
            System.out.println("5. Mostrar ruta mas corta");
            System.out.println("6. Mostrar ingresos");
            System.out.println("7. Salir");
            System.out.println("==========================================");
            System.out.print("Seleccione una opcion: ");

            opcion = entrada.nextInt();
            entrada.nextLine();

            System.out.println();

            switch (opcion) {

                case 1:
                    ingresarVehiculo();
                    break;

                case 2:
                    retirarVehiculo();
                    break;

                case 3:
                    mostrarEstacionamiento();
                    break;

                case 4:
                    buscarVehiculo();
                    break;

                case 5:
                    mostrarRutaMasCorta();
                    break;

                case 6:
                    mostrarIngresos();
                    break;

                case 7:
                    System.out.println("Gracias por utilizar el sistema.");
                    break;

                default:
                    System.out.println("Opcion invalida. Intente nuevamente.");
                    break;
            }

        } while (opcion != 7);
    }

    // =========================
    // INGRESAR VEHÍCULO
    // =========================
    public static void ingresarVehiculo() {

        System.out.println("===== INGRESAR VEHICULO =====");

        System.out.print("Ingrese la placa: ");
        String placa = entrada.nextLine().toUpperCase();

        // Validar placa
        if (!placaValida(placa)) {

            System.out.println("Placa invalida.");
            System.out.println("Formato correcto: P###LLL");
            return;
        }

        // Verificar si la placa ya existe
        if (placaExiste(placa)) {

            System.out.println("La placa ya esta registrada.");
            return;
        }

        // Pedir fila
        System.out.print("Ingrese la fila (1-8): ");
        int fila = entrada.nextInt();

        // Pedir columna
        System.out.print("Ingrese la columna (1-8): ");
        int columna = entrada.nextInt();

        entrada.nextLine();

        // Validar posición
        if (fila < 1 || fila > FILAS ||
                columna < 1 || columna > COLUMNAS) {

            System.out.println("Posicion invalida.");
            return;
        }

        // Convertir a índices del arreglo
        int f = fila - 1;
        int c = columna - 1;

        // Verificar si está ocupado
        if (placas[f][c] != null) {

            System.out.println("Ese espacio ya esta ocupado.");
            return;
        }

        // Solicitar pago
        double pago;

        do {

            System.out.print("Monto entregado: Q");
            pago = entrada.nextDouble();
            entrada.nextLine();

            if (pago < 0) {

                System.out.println("No se aceptan montos negativos.");

            } else if (pago < TARIFA) {

                System.out.println("Pago insuficiente.");
                System.out.println("La tarifa es de Q10.00.");
            }

        } while (pago < TARIFA);

        // Calcular cambio
        double cambio = pago - TARIFA;

        // Registrar vehículo
        placas[f][c] = placa;

        // Registrar ingreso
        vehiculosCobrados++;
        totalIngresos += TARIFA;

        System.out.println();
        System.out.println("Vehiculo registrado correctamente.");
        System.out.println("Placa: " + placa);
        System.out.println("Fila: " + fila);
        System.out.println("Columna: " + columna);
        System.out.printf("Cambio: Q%.2f%n", cambio);
    }

    // =========================
    // VALIDAR PLACA
    // =========================
    public static boolean placaValida(String placa) {

        if (placa.length() != 7) {
            return false;
        }

        // Primera posición debe ser P
        if (placa.charAt(0) != 'P') {
            return false;
        }

        // Posiciones 1,2,3 deben ser números
        for (int i = 1; i <= 3; i++) {

            if (!Character.isDigit(placa.charAt(i))) {
                return false;
            }
        }

        // Posiciones 4,5,6 deben ser letras
        for (int i = 4; i <= 6; i++) {

            if (!Character.isLetter(placa.charAt(i))) {
                return false;
            }
        }

        return true;
    }

    // =========================
    // VERIFICAR PLACA EXISTENTE
    // =========================
    public static boolean placaExiste(String placa) {

        for (int i = 0; i < FILAS; i++) {

            for (int j = 0; j < COLUMNAS; j++) {

                if (placa.equals(placas[i][j])) {

                    return true;
                }
            }
        }

        return false;
    }

    // =========================
    // RETIRAR VEHÍCULO
    // =========================
    public static void retirarVehiculo() {

        System.out.println("===== RETIRAR VEHICULO =====");

        System.out.print("Ingrese la placa del vehiculo: ");
        String placa = entrada.nextLine().toUpperCase();

        for (int i = 0; i < FILAS; i++) {

            for (int j = 0; j < COLUMNAS; j++) {

                if (placa.equals(placas[i][j])) {

                    placas[i][j] = null;

                    System.out.println();
                    System.out.println("Vehiculo retirado correctamente.");
                    System.out.println("Fila: " + (i + 1));
                    System.out.println("Columna: " + (j + 1));

                    return;
                }
            }
        }

        System.out.println("El vehiculo no se encuentra en el estacionamiento.");
    }

    // =========================
    // MOSTRAR ESTACIONAMIENTO
    // =========================
    public static void mostrarEstacionamiento() {

        System.out.println("===== ESTACIONAMIENTO =====");

        System.out.print("     ");

        for (int j = 1; j <= COLUMNAS; j++) {

            System.out.print(j + "   ");
        }

        System.out.println();

        for (int i = 0; i < FILAS; i++) {

            System.out.print((i + 1) + "   ");

            for (int j = 0; j < COLUMNAS; j++) {

                if (placas[i][j] == null) {

                    System.out.print("[L] ");

                } else {

                    System.out.print("[A] ");
                }
            }

            System.out.println();
        }

        int libres = contarEspaciosLibres();
        int ocupados = FILAS * COLUMNAS - libres;

        System.out.println();
        System.out.println("Espacios libres: " + libres);
        System.out.println("Espacios ocupados: " + ocupados);
    }

    // =========================
    // CONTAR ESPACIOS LIBRES
    // =========================
    public static int contarEspaciosLibres() {

        int libres = 0;

        for (int i = 0; i < FILAS; i++) {

            for (int j = 0; j < COLUMNAS; j++) {

                if (placas[i][j] == null) {

                    libres++;
                }
            }
        }

        return libres;
    }

    // =========================
    // BUSCAR VEHÍCULO
    // =========================
    public static void buscarVehiculo() {

        System.out.println("===== BUSCAR VEHICULO =====");

        System.out.print("Ingrese la placa: ");
        String placa = entrada.nextLine().toUpperCase();

        for (int i = 0; i < FILAS; i++) {

            for (int j = 0; j < COLUMNAS; j++) {

                if (placa.equals(placas[i][j])) {

                    System.out.println();
                    System.out.println("Vehiculo encontrado.");
                    System.out.println("Fila: " + (i + 1));
                    System.out.println("Columna: " + (j + 1));

                    return;
                }
            }
        }

        System.out.println("Vehiculo no encontrado.");
    }

    // =========================
    // RUTA MÁS CORTA
    // =========================
    public static void mostrarRutaMasCorta() {

        System.out.println("===== RUTA MAS CORTA =====");

        int distanciaHorario;
        int distanciaAntihorario;

        // Cálculo sencillo sobre el perímetro
        distanciaHorario =
                Math.abs(filaSalida - filaEntrada)
                + Math.abs(columnaSalida - columnaEntrada);

        distanciaAntihorario =
                (FILAS + COLUMNAS) * 2 - distanciaHorario;

        System.out.println("Entrada: fila "
                + (filaEntrada + 1)
                + ", columna "
                + (columnaEntrada + 1));

        System.out.println("Salida: fila "
                + (filaSalida + 1)
                + ", columna "
                + (columnaSalida + 1));

        System.out.println();

        System.out.println("Distancia sentido horario: "
                + distanciaHorario);

        System.out.println("Distancia sentido antihorario: "
                + distanciaAntihorario);

        if (distanciaHorario < distanciaAntihorario) {

            System.out.println("Ruta recomendada: sentido horario.");

        } else if (distanciaAntihorario < distanciaHorario) {

            System.out.println("Ruta recomendada: sentido antihorario.");

        } else {

            System.out.println("Ambas rutas tienen la misma distancia.");
        }
    }

    // =========================
    // MOSTRAR INGRESOS
    // =========================
    public static void mostrarIngresos() {

        System.out.println("===== INGRESOS =====");

        System.out.println("Vehiculos cobrados: "
                + vehiculosCobrados);

        System.out.printf("Tarifa por vehiculo: Q%.2f%n", TARIFA);

        System.out.printf("Total recaudado: Q%.2f%n",
                totalIngresos);
    }
}
